{
  "name": "openjcockpit-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "sync-docs": "node scripts/sync-product-docs.mjs",
    "prestart": "npm run sync-docs",
    "prebuild": "npm run sync-docs",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "check-tokens": "node scripts/check-tokens.mjs",
    "check-links": "node scripts/check-links.mjs",
    "check-links:external": "node scripts/check-links.mjs --external",
    "lint": "prettier --check 'docs/**/*.{md,mdx}' 'blog/**/*.{md,mdx}' README.md CONTENT_CHECKLIST.md && markdownlint-cli2",
    "format": "prettier --write 'docs/**/*.{md,mdx}' 'blog/**/*.{md,mdx}' README.md CONTENT_CHECKLIST.md"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "d3-transition": "^3.0.2",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "overrides": {
    "tinypool": "^2.2.0",
    "serialize-javascript": "^7.1.4",
    "uuid": "^11.1.1"
  }
}
